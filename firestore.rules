rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //=== CORE SECURITY HELPERS ===
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() && getUserData().access_level == 'admin';
    }
    function isEndUser() {
      return isAuthenticated() && getUserData().access_level == 'end_user';
    }
    // Updated helper function
    function isValidPermit() {
      let data = request.resource.data;
      return data.user_id == request.auth.uid 
        && data.permit_type in ['LATE', 'OVERNIGHT', 'WEEKEND'] // Fixed from 'type'
        && data.permit_status == 'PENDING'
        && (!data.keys().hasAny(['actual_time_in']) || data.actual_time_in == null)
        && (!data.keys().hasAny(['approved_by']) || data.approved_by == null)
        && (!data.keys().hasAny(['disapproval_reason']) || data.disapproval_reason == null)
        && data.created_at == request.time; 
    }
    function isPermitOwner(permitId) {
      return get(/databases/$(database)/documents/permits/$(permitId)).data.user_id == request.auth.uid;
    }
    //check-in code helpers 
    function checkinCodePath(permitId) {
      return /databases/$(database)/documents/checkin_codes/$(permitId);
    }
    // a permit that can still be timed in
    function isOpenPermit(permit){
      return permit.permit_status in ['ACTIVE', 'OVERDUE'] && permit.get('actual_time_in', null) == null;
    }
    //shape of a code document written by an admin
    function isValidCheckinCodeDoc(){
      let d = request.resource.data;
      return d.keys().hasOnly(['code', 'expires_at', 'created_by'])
        && d.keys().hasAll(['code', 'expires_at', 'created_by'])
        && d.code is string
        && d.code.matches('[0-9]{6}')
        && d.created_by == request.auth.uid
        && d.expires_at is timestamp
        && d.expires_at > request.time
        // admin device clock can be off; never allow a window beyond 10 minutes
        && d.expires_at <= request.time + duration.value(10, 'm');
      
    }

    //=== RULES FOR COLLECTIONS ===
    match /users/{userId} {
      // read by owner-dormer, admin can view anyone
      allow read: if isOwner(userId) || isAdmin();

      // allows creation of acc by admin either an end_user or an admin
      allow create: if isAdmin()
        && request.resource.data.access_level in ['end_user', 'admin'];
      
      // allows admin to delete or remove user records belonging to an end_user
      allow delete: if isAdmin()
        && resource.data.access_level == 'end_user';

      allow update: if isAdmin() 
        || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['access_level']));
    }
    match /admin_profiles/{userId} {
      // allows admin to read own profile
      allow read: if isOwner(userId) || isAdmin();

      // allows admin to create profiles for fellow admins
      // if userId exists in datbase and the access level of the user is admin
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.access_level == 'admin';
      
      // allows admin to update profile
      allow update: if isOwner(userId) && isAdmin();

      // allows admin to delete other admin's profile
      allow delete: if isAdmin()
        && !isOwner(userId);
    }
    match /end_user_profiles/{userId} {
      // allows admin and owner read
      allow read: if isOwner(userId) || isAdmin();
      
      // allows creation by admin
      // if userId exists in datbase and the access level of the user is end_user
      
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.access_level == 'end_user';
      
      // allows update of display_photo and phone_num only for the owner
      allow update: if isOwner(userId) && isEndUser()
        && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['display_photo', 'phone_num']);

      // allows deletion by admin
      allow delete: if isAdmin();
    }
    match /permits/{permitId} {
      // allows dormer to create a pending permit
      allow create: if isAuthenticated() 
        && isEndUser()
        && isValidPermit();

      // allows dormer to read their own permit
      // if they are logged in
      // read for admin
      allow read: if isAuthenticated() 
        && (resource.data.user_id == request.auth.uid || isAdmin());

      //ADMIN: review a permit and record time-in.
      // Field-limited, but no status-flow checks here, the service layer
      // (updatePermitStatus / recordTimeIn) enforces the transitions.

      allow update: if 
      (isAdmin()
        && isAuthenticated()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'permit_status', 'approved_by', 'approved_at', 'disapproval_reason', 
             'actual_time_in', 'time_in_recorded_by'
           ]))
      //OWNER: cancel a PENDING or ACTIVE permit
      // OVERDUE is intentionally excluded, a late student cannot withdraw
     ||
      (isEndUser()
        && resource.data.user_id == request.auth.uid
        && resource.data.permit_status in ['PENDING', 'ACTIVE']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permit_status'])
        && request.resource.data.permit_status == 'CANCELLED')

       // OWNER: complete an ACTIVE with no time-in yet, 
       // by submiting the admin's check-in code 
       //Requires the code to match checin_codes.{permitId}, request.time is before 
       //expires_at, and actual_time_in == request.time (serverTimestamp())
       //
       //RISK, a student could guess the code
      //
      // The code has 6 digits, so there are 1,000,000 possible codes
      // A student can write a small script that tries many codes quickly while 
      // the code is still valid, for 5 minutes. A wrong guess is simply rejected, and 
      // Firestore rules cannot remember how many wrong guesses someone already made, 
      // so there is no way to say "stop after 5 tries" here.
      || 
      (isEndUser()
        && resource.data.user_id == request.auth.uid
        && resource.data.permit_status == 'ACTIVE'
        && resource.data.get('actual_time_in', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permit_status', 'actual_time_in', 'checkin_code_submitted'])
        && request.resource.data.permit_status == 'COMPLETED'
        && request.resource.data.actual_time_in == request.time
        && exists(checkinCodePath(permitId))
        && request.resource.data.checkin_code_submitted == get(checkinCodePath(permitId)).data.code
        && request.time < get(checkinCodePath(permitId)).data.expires_at);

      
      // only admin can delete
      allow delete: if isAdmin();
    }

      
     
        
    match /checkin_codes/{permitId} {
      // admin-only read: students must never be able to read the code
      allow read: if isAdmin();      

      //admin creates the code for an open permit(ACTIVE or OVERDUE, no time-in)
      // with valid shape, exact keys, 6 digits, expires withnin 10 minutes
      allow create: if isAdmin()
        && isOpenPermit(get(/databases/$(database)/documents/permits/$(permitId)).data)
        && isValidCheckinCodeDoc();

      // admin replaces an older code. A transaction set() on an existing
      // document is an update, so it needs its own rule.
      allow update: if isAdmin()
        && isOpenPermit(get(/databases/$(database)/documents/permits/$(permitId)).data)
        && isValidCheckinCodeDoc();

      // cannot be deleted
      allow delete: if false;
    }
    match /delinquency_logs/{logId} {
      // allows read by owner and admin
      allow read: if isAuthenticated() 
        && (resource.data.user_id == request.auth.uid || isAdmin());
      
      // allows create, update, and delete only by admin
      allow create, update, delete: if isAdmin();
    }
  }
}
