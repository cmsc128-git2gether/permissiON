rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //=== CORE SECURITY HELPERS ===
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuthenticated() && getUserData().access_level == 'admin';
    }
    function isEndUser() {
      return isAuthenticated() && getUserData().access_level == 'end_user';
    }
    function isValidPermit() {
      let data = request.resource.data;
      return data.user_id == request.auth.uid 
        && data.type in ['LATE', 'OVERNIGHT', 'WEEKEND']
        && data.permit_status == 'PENDING';
    }
    function isPermitOwner(permitId) {
      return get(/databases/$(database)/documents/permits/$(permitId)).data.user_id == request.auth.uid;
    }

    //=== RULES FOR COLLECTIONS ===
    match /users/{userId} {
      // read by owner-dormer, admin can view anyone
      allow read: if isOwner(userId) || isAdmin();

      // allows creation of acc by admin either an end_user or an admin
      allow create: if isAdmin()
        && request.resource.data.access_level in ['end_user', 'admin'];
      
      // allows admin to delete or remove user records belonging to an end_user
      allow delete: if isAdmin()
        && request.resource.data.access_level in ['end_user'];
    }
    match /admin_profiles/{userId} {
      // allows admin to read own profile
      allow read: if isOwner(userId) || isAdmin();

      // allows admin to create profiles for fellow admins
      // if userId exists in datbase and the access level of the user is admin
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.access_level == 'admin';
      
      // allows admin to update profile
      allow update: if isOwner(userId) && isAdmin();

      // allows admin to delete other admin's profile
      allow delete: if isAdmin()
        && !isOwner(userId);
    }
    match /end_user_profiles/{userId} {
      // allows admin and owner read
      allow read: if isOwner(userId) || isAdmin();
      
      // allows creation by admin
      // if userId exists in datbase and the access level of the user is end_user
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.access_level == 'end_user';
      
      // allows update of display_photo and phone_num only for the owner
      allow update: if isOwner(userId) && isEndUser()
        && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['display_photo', 'phone_num']);

      // allows deletion by admin
      allow delete: if isAdmin();
    }
    match /permits/{permitId} {
      // allows dormer to create a pending permit
      allow create: if isAuthenticated() 
        && isEndUser()
        && isValidPermit();

      // allows dormer to read their own permit
      // if they are logged in
      // read for admin
      allow read: if isAuthenticated() 
        && (resource.data.user_id == request.auth.uid || isAdmin());

      // allows update for admin status 
      allow update: if (isAdmin()
        && isAuthenticated()
        && request.resource.data.permit_status in 
        ['PENDING', 'ACTIVE', 'CANCELLED', 'DENIED', 'COMPLETED', 'OVERDUE'])
        
        // allows permit owner to cancel a pending or an active permit
        || (isEndUser()
        && resource.data.user_id == request.auth.uid
        && resource.data.permit_status in ['PENDING', 'ACTIVE']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.permit_status == 'CANCELLED');
      
      // only admin can delete
      allow delete: isAdmin();
    }
    match /checkin_codes/{permitId} {
      // admin-only read
      allow read: if isAuthenticated()
        && isAdmin();
      
      // allow creation of checkin_codes
      // if permit_status is active
      // if scanned fields are null
      // if not yet expired
      allow create: if isAdmin()
        && request.resource.data.admin_id == request.auth.uid
        && request.resource.data.permit_status == 'ACTIVE'
        && request.resource.data.scanned_at == null
        && request.resource.data.scanned_by == null
        && request.resource.data.expires_at > request.time;
      
      // allows update 
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permit_status'])
        && request.resource.data.permit_status == 'CANCELLED')
        // permit owner can scan 
        || (isEndUser()
        && isPermitOwner(resource.data.permit_id)
        && resource.data.permit_status == 'ACTIVE'
        && resource.data.expires_at > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['permit_status', 'scanned_at', 'scanned_by'])
        && request.resource.data.permit_status == 'SCANNED'
        && request.resource.data.scanned_by == request.auth.uid
        && request.resource.data.scanned_at == request.time);
      
      // cannot be deleted
      allow delete: if false;
    }
    match /delinquency_logs/{logId} {
      // allows read by owner and admin
      allow read: if isAuthenticated() 
        && (resource.data.user_id == request.auth.uid || isAdmin());
      
      // allows create, update, and delete only by admin
      allow create, update, delete: if isAdmin();
    }
  }
}
